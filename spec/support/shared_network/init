#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
/bin/busybox mkdir -p /tmp
/sbin/modprobe virtio_net
for arg in $(/bin/busybox cat /proc/cmdline); do
  case "$arg" in
    proof.ip=*) address="${arg#proof.ip=}" ;;
    proof.name=*) name="${arg#proof.name=}" ;;
  esac
done
/bin/busybox ip link set lo up
attempt=0
until /bin/busybox ip link set eth0 up; do
  attempt=$((attempt + 1))
  [ "$attempt" -lt 10 ] || exit 1
  /bin/busybox sleep 1
done
/bin/busybox ip addr add "$address/24" dev eth0
/bin/busybox stty -F /dev/ttyS0 raw -echo
exec /probe daemon "$name"
